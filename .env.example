# =========================================================================
# OpenScholar — Environment Variables
# =========================================================================
# Copy to .env and fill in real values. NEVER commit .env.
# =========================================================================

# ---- Postgres ----
POSTGRES_USER=openscholar
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=openscholar

# ---- Backend ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string

# ---- LLM providers ----
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional fallback / secondary provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Research tools (used from Phase 2 onward) ----
# Tavily: https://tavily.com (1000 free searches/month)
TAVILY_API_KEY=
# Brave Search (optional alternative): https://api.search.brave.com/
BRAVE_SEARCH_API_KEY=

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000
